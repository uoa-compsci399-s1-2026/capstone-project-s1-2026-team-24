# Prisma SQLite database path.
# IMPORTANT: this path resolves relative to the current working directory, so it
# MUST point at prisma/dev.db (the seeded database). Using "file:./dev.db" creates
# a SECOND, empty database at the repo root, and the app/media library will look
# empty even after seeding. Keep this exactly as below.
DATABASE_URL="file:./prisma/dev.db"

# Admin authentication — plain string password for the admin auth middleware.
ADMIN_PASSWORD="change-me"

# Random string used to sign the admin session cookie (use a long random value).
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# --- Public site URLs ---
# Canonical site URL, used for metadata/SEO (read by src/lib/constants.ts).
# Leave blank for local development.
NEXT_PUBLIC_SITE_URL=
# Base URL for server-side self-fetch of internal APIs (read by src/lib/fetch-api.ts).
# Leave blank locally (defaults to http://localhost:3000); set to the deployed origin
# in production/preview so server components can reach the API.
NEXT_PUBLIC_BASE_URL=

# --- ORCID publications sync ---
# Public ORCID API base. Defaults to PRODUCTION (https://pub.orcid.org/v3.0), which
# needs NO auth for public records (no client ID/secret required). Override to the
# sandbox for testing (https://pub.sandbox.orcid.org/v3.0).
ORCID_API_BASE_URL=""
# Optional contact email sent to OpenAlex (used for per-paper affiliation data).
# Identifying yourself opts into OpenAlex's faster, more reliable "polite pool".
OPENALEX_MAILTO=""
# Optional: override the OpenAlex API base (tests / proxies).
OPENALEX_API_BASE_URL=""

# --- Machine translation (auto-translates non-study site copy to 中文) ---
# Optional. When unset, the public site still works: Chinese renders fixed UI
# (from src/messages) and falls back to English for admin-authored page copy.
# Translations are generated when an admin publishes a page (or via `npm run
# warm:translations`) and cached in the DB, so the public site never calls the API
# at view time. Provider: azure (default, 2M chars/mo free) | google | deepl (500k free).
TRANSLATE_PROVIDER="azure"
TRANSLATE_API_KEY=""
# Azure only: the resource region (e.g. australiaeast). Omit for a "Global" resource.
TRANSLATE_REGION=""
# Optional: override the API host (tests / proxies / self-hosted).
TRANSLATE_ENDPOINT=""

# --- Contact-form email (Resend) ---
# Optional. When RESEND_API_KEY is unset, contact submissions are still saved; the
# email notification is logged and skipped (no network calls in dev/CI).
RESEND_API_KEY=""
# The "from" address. MUST be on a domain verified in Resend for real delivery.
# When unset, the app uses Resend's shared test sender (onboarding@resend.dev), which
# can only deliver to the email address that owns your Resend account.
EMAIL_FROM=""
